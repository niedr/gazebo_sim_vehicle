<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="car_city">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Road -->
    <model name="road">
      <pose>0 0 0.01 0 0 0</pose>
      <static>true</static>
      <link name="l">
        <visual name="v"><geometry><box><size>30 8 0.02</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ramp up -->
    <model name="ramp_up">
      <pose>12 -3 0 0 0.3 0</pose>
      <static>true</static>
      <link name="l">
        <visual name="v"><geometry><box><size>5 3 0.5</size></box></geometry>
          <material><ambient>0.5 0.3 0 1</ambient><diffuse>0.7 0.5 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>5 3 0.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- Ramp down -->
    <model name="ramp_down">
      <pose>20 -3 2.5 0 -0.3 0</pose>
      <static>true</static>
      <link name="l">
        <visual name="v"><geometry><box><size>5 3 0.5</size></box></geometry>
          <material><ambient>0.5 0.3 0 1</ambient><diffuse>0.7 0.5 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>5 3 0.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- Jump platform -->
    <model name="ramp_plat">
      <pose>16 -3 1.4 0 0 0</pose>
      <static>true</static>
      <link name="l">
        <visual name="v"><geometry><box><size>3 3 0.3</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>3 3 0.3</size></box></geometry></collision>
      </link>
    </model>

    <!-- Buildings -->
    <model name="b1"><pose>10 5 2.5 0 0 0</pose><static>true</static>
      <link name="l"><visual name="v"><geometry><box><size>5 5 5</size></box></geometry>
        <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.2 0.2 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>5 5 5</size></box></geometry></collision>
      </link>
    </model>
    <model name="b2"><pose>-8 6 3 0 0 0</pose><static>true</static>
      <link name="l"><visual name="v"><geometry><box><size>4 4 6</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>4 4 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="b3"><pose>-6 -7 2 0 0 0</pose><static>true</static>
      <link name="l"><visual name="v"><geometry><box><size>6 6 4</size></box></geometry>
        <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.2 1 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>6 6 4</size></box></geometry></collision>
      </link>
    </model>
    <model name="b4"><pose>12 -6 4 0 0 0</pose><static>true</static>
      <link name="l"><visual name="v"><geometry><box><size>3 3 8</size></box></geometry>
        <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>1 1 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>3 3 8</size></box></geometry></collision>
      </link>
    </model>
    <model name="b5"><pose>10 -8 5 0 0 0</pose><static>true</static>
      <link name="l"><visual name="v"><geometry><box><size>2 2 10</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2 2 10</size></box></geometry></collision>
      </link>
    </model>

    <!-- Trees -->
    <model name="t1"><pose>14 4 0 0 0 0</pose><static>true</static>
      <link name="l">
        <visual name="trunk"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <pose>0 0 0.75 0 0 0</pose>
          <material><ambient>0.4 0.2 0 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
        <visual name="crown"><geometry><sphere><radius>0.8</radius></sphere></geometry>
          <pose>0 0 2 0 0 0</pose>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <pose>0 0 0.75 0 0 0</pose></collision>
      </link>
    </model>
    <model name="t2"><pose>-10 3 0 0 0 0</pose><static>true</static>
      <link name="l">
        <visual name="trunk"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <pose>0 0 0.75 0 0 0</pose>
          <material><ambient>0.4 0.2 0 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
        <visual name="crown"><geometry><sphere><radius>0.8</radius></sphere></geometry>
          <pose>0 0 2 0 0 0</pose>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <pose>0 0 0.75 0 0 0</pose></collision>
      </link>
    </model>

    <!-- ============ SPORTS CAR ============ -->
    <model name="car">
      <pose>0 0 0.15 0 0 0</pose>
      <link name="chassis">
        <pose>0 0 0.2 0 0 0</pose>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.15</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.4</iyy><iyz>0</iyz><izz>0.5</izz></inertia>
        </inertial>
        <visual name="body"><geometry><box><size>0.5 0.3 0.15</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="roof"><pose>-0.05 0 0.15 0 0 0</pose>
          <geometry><box><size>0.25 0.22 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="spoiler"><pose>-0.25 0 0.1 0 0 0</pose>
          <geometry><box><size>0.02 0.25 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="hl_l"><pose>0.25 0.1 0.05 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>1 1 0.5 1</ambient><diffuse>1 1 0.8 1</diffuse></material>
        </visual>
        <visual name="hl_r"><pose>0.25 -0.1 0.05 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>1 1 0.5 1</ambient><diffuse>1 1 0.8 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.5 0.3 0.15</size></box></geometry></collision>
      </link>

      <link name="fl"><pose>0.15 0.2 0.1 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia></inertial>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
      <link name="fr"><pose>0.15 -0.2 0.1 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia></inertial>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
      <link name="rl"><pose>-0.15 0.2 0.1 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia></inertial>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>
      <link name="rr"><pose>-0.15 -0.2 0.1 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia></inertial>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </collision>
      </link>

      <joint name="fl_j" type="revolute"><parent>chassis</parent><child>fl</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="fr_j" type="revolute"><parent>chassis</parent><child>fr</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rl_j" type="revolute"><parent>chassis</parent><child>rl</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rr_j" type="revolute"><parent>chassis</parent><child>rr</child><axis><xyz>0 1 0</xyz></axis></joint>

      <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <robotNamespace>car</robotNamespace>
        <left_joint>fl_j</left_joint><left_joint>rl_j</left_joint>
        <right_joint>fr_j</right_joint><right_joint>rr_j</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odometry</odom_topic>
        <min_velocity>-5</min_velocity>
        <max_velocity>5</max_velocity>
        <min_acceleration>-5</min_acceleration>
        <max_acceleration>5</max_acceleration>
      </plugin>
    </model>
  </world>
</sdf>
